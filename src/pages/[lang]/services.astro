---
import ServicesPage from '../../components/pages/ServicesPage.astro';
import { nonDefaultLangs } from '../../i18n/config';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<ServicesPage lang={lang} />
