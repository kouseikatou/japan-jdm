---
import ShippingPage from '../../components/pages/ShippingPage.astro';
import { nonDefaultLangs } from '../../i18n/config';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<ShippingPage lang={lang} />
