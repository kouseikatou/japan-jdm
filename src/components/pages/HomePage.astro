---
import Base from '../../layouts/Base.astro';
import VehicleCard from '../VehicleCard.astro';
import { vehicles } from '../../data/vehicles';
import { useTranslations } from '../../i18n';
import { extra } from '../../i18n/extra';
import { localePath, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = t.home;
const x = extra[lang];
const companyRows = [home.company.rows[0], { label: x.representative, value: x.representativeName }, ...home.company.rows.slice(1)];
const link = (path: string) => localePath(lang, path);
const request = (value: string) => `${link('/contact')}?car=${encodeURIComponent(value)}`;

const faqs = t.services.faqs.slice(0, 4);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base lang={lang} title={t.meta.home.title} description={t.meta.home.description}>
  <section class="hero">
    <img class="hero-image" src="/img/hero-nagoya-night.jpg" alt="" width="1672" height="940" fetchpriority="high" />
    <video class="hero-image hero-video" autoplay muted loop playsinline preload="auto" poster="/img/hero-nagoya-night.jpg" aria-hidden="true" tabindex="-1">
      <source src="/img/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow rise" style="--i:0">{home.eyebrow}</p>
      <h1>
        {home.headline.map((line, i) => (
          <span class="line"><span class="rise" style={`--i:${i + 1}`}>{line}</span></span>
        ))}
      </h1>
      <p class="lede rise" style="--i:4">{home.lede}</p>

      <form class="search rise" style="--i:5" action={link('/contact')} method="get">
        <p class="search-title">{home.search.label}</p>
        <div class="search-row">
          <label>
            <span>{home.search.make}</span>
            <input name="car" placeholder={home.search.makePlaceholder} required />
          </label>
          <label>
            <span>{home.search.year}</span>
            <select name="year">
              {home.search.yearOptions.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </label>
          <button class="btn" type="submit">{home.search.submit}</button>
        </div>
        <a class="text-link" href={link('/inventory')}>{home.browseStock} &rarr;</a>
      </form>
    </div>
  </section>

  <div class="wrap proof">
    {home.proof.map((p, i) => (
      <div data-reveal style={`--d:${i}`}>
        <strong>{p.title}</strong>
        <span>{p.text}</span>
      </div>
    ))}
  </div>

  <section class="section">
    <div class="wrap">
      <header class="head" data-reveal>
        <p class="eyebrow">{home.featured.eyebrow}</p>
        <h2>{x.stockTitle}</h2>
        <p class="lede">{x.stockLede}</p>
      </header>
      <div class="vehicle-grid">
        {vehicles.slice(0, 3).map((car) => <VehicleCard lang={lang} car={car} />)}
      </div>
      <p class="more"><a class="text-link" href={link('/inventory')}>{home.featured.viewAll} &rarr;</a></p>
    </div>
  </section>

  <section class="section tone">
    <div class="wrap">
      <header class="head" data-reveal>
        <p class="eyebrow">{home.categories.eyebrow}</p>
        <h2>{home.categories.title}</h2>
      </header>
      <div class="tiles">
        {home.categories.items.map((c, i) => (
          <a class="tile" href={request(c.value)} data-reveal style={`--d:${i}`}>
            <span>{c.label}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <header class="head" data-reveal>
          <p class="eyebrow">{home.whatWeDo.eyebrow}</p>
          <h2>{home.whatWeDo.title[0]}<br />{home.whatWeDo.title[1]}</h2>
        </header>
        <ol class="numbered">
          {home.whatWeDo.services.map((s, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <div><h3>{s.title}</h3><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <figure class="figure blueprint" data-reveal>
        <img src="/img/blueprint-coupe.png" alt={home.whatWeDo.illustrationAlt} width="1600" height="900" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section tone">
    <div class="wrap">
      <header class="head" data-reveal>
        <p class="eyebrow">{home.buy.eyebrow}</p>
        <h2>{home.buy.title}</h2>
      </header>
      <ol class="steps">
        {t.services.steps.map((s, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="more"><a class="text-link" href={link('/services')}>{home.buy.link} &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <header class="head" data-reveal>
          <p class="eyebrow">{home.terms.eyebrow}</p>
          <h2>{home.terms.title}</h2>
        </header>
        <dl class="table" data-reveal>
          {home.terms.rows.map((r) => (
            <div><dt>{r.label}</dt><dd>{r.value}</dd></div>
          ))}
        </dl>
        <p class="more"><a class="text-link" href={link('/shipping')}>{home.terms.link} &rarr;</a></p>
      </div>
      <figure class="figure photo" data-reveal>
        <img src="/img/port-export.jpg" alt={home.port.photoAlt} width="1672" height="940" loading="lazy" />
        <figcaption>
          <strong>{home.port.eyebrow}</strong>
          <span>{home.port.title[0]} {home.port.title[1]}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section tone">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">{home.company.eyebrow}</p>
        <h2>{home.company.title}</h2>
        <dl class="table">
          {companyRows.map((r) => (
            <div><dt>{r.label}</dt><dd>{r.value}</dd></div>
          ))}
        </dl>
        <p class="more"><a class="text-link" href={link('/about')}>{home.company.more} &rarr;</a></p>
      </div>
      <div data-reveal style="--d:1">
        <p class="eyebrow">{home.safety.eyebrow}</p>
        <h2>{home.safety.title}</h2>
        <ul class="checks">
          {home.safety.items.map((s) => (
            <li><strong>{s.title}</strong><span>{s.text}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <header class="head" data-reveal>
        <p class="eyebrow">{home.faqEyebrow}</p>
        <h2>{home.faqTitle}</h2>
      </header>
      <div class="faq" data-reveal>
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap narrow">
      <p class="eyebrow" data-reveal>{home.cta.eyebrow}</p>
      <h2 data-reveal style="--d:1">{home.cta.title[0]}<br />{home.cta.title[1]}</h2>
      <p class="lede" data-reveal style="--d:2">{home.cta.text}</p>
      <a class="btn" data-reveal style="--d:3" href={link('/contact')}>{home.cta.button}</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>
