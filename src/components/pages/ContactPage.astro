---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
const f = c.form;
---

<Base lang={lang} title={t.meta.contact.title} description={t.meta.contact.description}>
  <section class="section page-top">
    <div class="wrap">
      <header class="head">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 class="h2">{c.title}</h1>
        <p class="lede">{c.lede}</p>
      </header>

      <div class="contact-layout">
        <form id="contact-form" action="/api/contact" method="post" data-sending={f.sending} data-success={f.success} data-error={f.error}>
          <div class="two">
            <label>{f.name}<input name="name" required autocomplete="name" /></label>
            <label>{f.email}<input name="email" type="email" required autocomplete="email" /></label>
          </div>
          <label>{f.car}<input name="car" id="car" required placeholder={f.carPlaceholder} /></label>
          <div class="two">
            <label>
              {f.budget}
              <select name="budget">{f.budgetOptions.map((o) => <option value={o.value}>{o.label}</option>)}</select>
            </label>
            <label>{f.region}<input name="region" placeholder={f.regionPlaceholder} /></label>
          </div>
          <label>{f.company}<input name="company" autocomplete="organization" /></label>
          <label>{f.message}<textarea name="message"></textarea></label>
          <input type="hidden" name="interest" value="Vehicle request" />
          <input type="hidden" name="lang" value={lang} />
          <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
          <div><button class="btn" type="submit">{f.submit}</button></div>
          <p id="form-status" role="status" class="note" hidden></p>
        </form>

        <aside class="aside">
          <h3>{c.next.title}</h3>
          <ol>
            {c.next.steps.map((s) => <li><strong>{s.strong}</strong> {s.text}</li>)}
          </ol>
          <h3 class="aside-sub">{c.detailsTitle}</h3>
          <dl class="table compact">
            <div><dt>{t.home.company.rows[1].label}</dt><dd>{t.home.company.rows[1].value}</dd></div>
            <div><dt>{t.home.company.rows[2].label}</dt><dd><a href={`tel:${t.company.phone.replace(/-/g, '')}`}>{t.home.company.rows[2].value}</a></dd></div>
            <div><dt>{t.home.company.rows[3].label}</dt><dd><a href={`mailto:${t.company.email}`}>{t.company.email}</a></dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  function initContact() {
    const params = new URLSearchParams(window.location.search);
    const car = params.get('car');
    const year = params.get('year');
    const carField = document.getElementById('car') as HTMLInputElement | null;
    if (car && carField) carField.value = year ? `${car} (${year}+)` : car;

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    if (!form || !status) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = false;
      status.textContent = form.dataset.sending ?? '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.success ?? '';
      } catch {
        status.textContent = form.dataset.error ?? '';
      }
    });
  }
  document.addEventListener('astro:page-load', initContact);
</script>
